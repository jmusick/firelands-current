# Only resolve package versions published at least 7 days ago. A malicious
# release is usually pulled within days, so a short wait removes most of that
# exposure. This applies when npm resolves versions (npm install, npm update,
# adding a package); `npm ci` installs exactly what package-lock.json pins.
# Emergency exceptions: see "Dependency cooldown" in README.md.
min-release-age=7
