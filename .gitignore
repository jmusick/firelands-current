# Dependencies and generated build/runtime files
node_modules/
/dist/
/.astro/
/.wrangler/
/worker-configuration.d.ts
*.tsbuildinfo

# Local environment values; keep safe setup templates
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Temporary work, generated reports, and local exports
/.tmp/
/.cache/
/coverage/
/test-results/
# Secret scan reports are redacted terminal output only; never write them to the repo.
gitleaks-report*
*.sarif
/playwright-report/
/backups/
/exports/
*.log
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Python utility caches and environments
__pycache__/
*.py[cod]
.venv/
venv/

# Machine-specific editor and operating-system files
.vscode/settings.json
.vscode/*.local.json
.claude/settings.local.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
