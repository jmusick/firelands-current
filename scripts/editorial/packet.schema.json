{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firelands-current:editorial-packet:1",
  "title": "Firelands Current editorial packet v1",
  "description": "Structural schema. The tool also enforces referential integrity, valid calendar dates, update-field allowlists, checksums, baseline hashes and publication guards.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "author": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "email",
        "name"
      ]
    },
    "publish_window": {
      "type": "object",
      "properties": {
        "until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "until"
      ]
    },
    "facebook": {
      "type": "object",
      "properties": {
        "queue": {
          "oneOf": [
            {
              "const": "new-stories"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          ]
        },
        "queue_detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "expect": {
      "type": "object",
      "properties": {
        "stories": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "updates": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "integer",
          "minimum": 0
        },
        "reused_media": {
          "type": "integer",
          "minimum": 0
        },
        "uploads": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "community": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "media": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "slug",
          "section",
          "community",
          "headline",
          "summary",
          "body"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "starts_on": {
            "type": "string",
            "format": "date"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "hours_note": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "community": {
            "type": "string",
            "minLength": 1
          },
          "organizer": {
            "type": "string",
            "minLength": 1
          },
          "organizer_url": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          },
          "ends_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "start_time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "end_time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": [
          "key",
          "slug",
          "title",
          "summary",
          "description",
          "category",
          "starts_on",
          "source_url"
        ]
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "enum": [
              "news_articles",
              "events"
            ]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "baseline_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "table",
          "slug",
          "baseline_sha256",
          "fields"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "featured": {
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "featured"
        ]
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "action": {
            "enum": [
              "reuse",
              "upload"
            ]
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "credit": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "audit_detail": {
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stored_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "license_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "required": [
          "key",
          "action",
          "caption",
          "credit"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "reuse"
                }
              }
            },
            "then": {
              "required": [
                "id",
                "sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "upload"
                }
              }
            },
            "then": {
              "required": [
                "file",
                "alt",
                "source",
                "source_url",
                "license_url",
                "original_sha256"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "date",
    "author",
    "stories",
    "events",
    "updates",
    "features",
    "media"
  ]
}
