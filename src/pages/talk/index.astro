---
import AuthorLink from '../../components/AuthorLink.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { feedAdBreaks } from '../../lib/ads';
import { fmtStoryDate, isoDateTime } from '../../lib/dates';
import { KIND_LABELS, THREAD_KINDS, listThreads, threadKind } from '../../lib/forum';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 && requestedPage <= 10000 ? requestedPage : 1;
const kind = threadKind(Astro.url.searchParams.get('type'));
const fetched = await listThreads(page - 1, Astro.locals.user?.id ?? '', kind);
const hasMore = fetched.length > 20;
const threads = fetched.slice(0, 20);
const adAfter = new Set(feedAdBreaks(threads.length));
const user = Astro.locals.user;
// Filter and page are kept in every link, so the filter survives paging.
const href = (over: { type?: string | null; page?: number }) => {
  const params = new URLSearchParams();
  const type = over.type === undefined ? kind : over.type;
  if (type) params.set('type', type);
  if (over.page && over.page > 1) params.set('page', String(over.page));
  return params.size ? `/talk?${params}` : '/talk';
};
---
<BaseLayout title="Talk of the Town" description="Local conversations from Sandusky and communities across the Firelands." canonicalPath={href({ page })}>
  <div class="head">
    <div><h1>Talk of the Town</h1><p class="lede">A place for neighbors to discuss what is happening across Sandusky and the surrounding region.</p></div>
    <a class="button" href={user ? '/talk/new' : '/sign-in?next=/talk/new'}>Start a discussion</a>
  </div>
  <nav class="filter-tabs" aria-label="Kinds of discussion">
    <a href={href({ type: null })} aria-current={kind === null ? 'page' : undefined}>All</a>
    {Object.entries(THREAD_KINDS).map(([key, label]) => <a href={href({ type: key })} aria-current={kind === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <p class="explainer">Every story and event has its own discussion: browse <a href={href({ type: 'story' })}>story discussions</a> or <a href={href({ type: 'event' })}>event discussions</a>.</p>
  <div>
    {threads.length === 0 ? <div class="card" style="margin-top:1rem"><h2>The conversation starts here</h2>{kind ? <p class="muted">Nothing here yet. Start the first one about something your neighbors should know or talk about.</p> : <p class="muted">No conversations yet. <a href={href({ type: 'story' })}>Browse story discussions</a> or <a href={user ? '/talk/new' : '/sign-in?next=/talk/new'}>start one</a>.</p>}</div> : threads.map((thread, i) => <><article class="thread"><div class="count" aria-hidden="true"><strong>{thread.reply_count}</strong>{thread.reply_count === 1 ? 'comment' : 'comments'}</div><div class="text"><h2><a href={`/talk/${thread.id}`}>{thread.title}</a></h2><p class="meta">{thread.kind === 'community' ? <>Started by <AuthorLink id={thread.author_id} name={thread.author_name} /></> : KIND_LABELS[thread.kind]}, <time datetime={isoDateTime(thread.created_at)}>{fmtStoryDate(thread.created_at)}</time><span class="sr">, {thread.reply_count} {thread.reply_count === 1 ? 'comment' : 'comments'}</span>, {thread.score} {Math.abs(thread.score) === 1 ? 'point' : 'points'}</p><p class="body">{thread.body.length > 240 ? thread.body.slice(0, 240) + '…' : thread.body}</p></div></article>{adAfter.has(i + 1) && <AdSlot placement="talk-feed" />}</>)}
  </div>
  {(page > 1 || hasMore) && <nav aria-label="Discussion pages" style="display:flex;justify-content:space-between;margin-top:1.5rem"><span>{page > 1 && <a href={href({ page: page - 1 })}>← Newer discussions</a>}</span><span>{hasMore && <a href={href({ page: page + 1 })}>Older discussions →</a>}</span></nav>}
</BaseLayout>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 1rem 2rem; flex-wrap: wrap; }
  .head .lede { margin-bottom: 0; }
  .explainer { margin: .9rem 0 0; color: var(--slate); font-size: .95rem; }
  /* The comment count leads each row: it's what tells a reader where the conversation is. */
  .thread { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1.25rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line-soft); }
  .count { display: grid; justify-items: start; align-content: start; padding-top: .3rem; border-top: 3px solid var(--deep); color: var(--slate); font-size: .82rem; }
  .count strong { color: var(--deep); font-size: 2.2rem; font-weight: 800; font-stretch: 62%; line-height: 1; font-variant-numeric: tabular-nums; }
  .thread h2 { margin: 0 0 .35rem; font-size: clamp(1.4rem, 2.8vw, 1.8rem); }
  .thread h2 a { color: inherit; text-decoration: none; }
  .thread h2 a:hover { color: var(--channel); }
  .thread .meta { margin: 0 0 .5rem; }
  .body { margin: 0; max-width: 36em; font-family: var(--read); font-size: 1.08rem; line-height: 1.5; color: #33474c; overflow-wrap: anywhere; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 560px) { .thread { grid-template-columns: 3.2rem minmax(0, 1fr); gap: .9rem; } .count { font-size: .72rem; } .count strong { font-size: 1.8rem; } }
</style>
