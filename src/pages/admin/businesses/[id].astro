---
import { readForm } from '../../../lib/request-body';
import { Archive, ArchiveRestore, ArrowLeft, Check, Info, Megaphone, Plus, RotateCcwClock, Trash, UserMinus, UserPlus, Users } from '@lucide/astro';
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BusinessForm from '../../../components/BusinessForm.astro';
import { ADMIN, requireSection } from '../../../lib/admin';
import { KIND_LABELS, MEMBER_ROLE_LABELS, describeChanges, getBusinessDetail, validateBusinessForm, valuesFromBusiness } from '../../../lib/businesses';
import { sameOrigin } from '../../../lib/forum';
import { ROLE_LABELS, isStaffRole } from '../../../lib/staff';
import { AUDIT_LABELS, auditStatement } from '../../../lib/users';
import { fmtDate, fmtDateTime } from '../../../lib/dates';
import { STATE_LABELS, listAds } from '../../../lib/ads-admin';

const denied = requireSection(Astro, ADMIN.businesses);
if (denied) return denied;

const detail = await getBusinessDetail(Astro.params.id ?? '');
if (!detail) return new Response('Business not found', { status: 404 });
const { business, members, audit } = detail;
const ads = await listAds({ q: '', business: business.id, state: '' });

let values = valuesFromBusiness(business);
let errors: string[] = [];
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Invalid request origin', { status: 403 });
  const form = await readForm(Astro.request);
  if (form instanceof Response) return form;
  const result = await validateBusinessForm(form, business.id);
  if (result.ok) {
    const changes = describeChanges(values, result.values);
    if (!changes) return Astro.redirect(`/admin/businesses/${business.id}?notice=unchanged`, 303);
    const v = result.values;
    await env.DB.batch([
      env.DB.prepare('UPDATE businesses SET name = ?, kind = ?, website = ?, email = ?, phone = ?, notes = ?, updated_at = ? WHERE id = ?')
        .bind(v.name, v.kind, v.website || null, v.email || null, v.phone || null, v.notes || null, Date.now(), business.id),
      auditStatement(Astro.locals.user!, { business: { id: business.id, name: v.name } }, 'business-update', changes),
    ]);
    return Astro.redirect(`/admin/businesses/${business.id}?notice=saved`, 303);
  }
  ({ values, errors } = result);
}

const NOTICES: Record<string, string> = {
  created: 'Business created. Add its people below.',
  saved: 'Details saved.',
  unchanged: 'Nothing changed.',
  archived: 'Business archived. Its members keep their accounts; no one new can be added until it’s restored.',
  restored: 'Business restored.',
  'member-added': 'Member added.',
  'member-updated': 'Membership updated.',
  'member-removed': 'Member removed. Their account is unchanged.',
};
const ERRORS: Record<string, string> = {
  'no-user': 'No account uses that email address. Create the account under Users first.',
  'already-member': 'That person is already a member of this business.',
  member: 'Choose a role, and keep the title under 80 characters.',
  archived: 'Restore this business before adding members.',
  confirm: 'The name you typed didn’t match. Nothing was deleted.',
};
const notice = NOTICES[Astro.url.searchParams.get('notice') ?? ''];
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''];
const archived = business.status === 'archived';
---
<AdminLayout title={business.name}>
  <a class="back" href="/admin/businesses"><ArrowLeft />All businesses</a>
  <span class="eyebrow" style="display:block;margin-top:1.5rem">Business · {KIND_LABELS[business.kind]}{archived && ' · Archived'}</span>
  <h1>{business.name}</h1>
  <p class="meta" style="margin-top:-.4rem">Added {fmtDate(business.created_at)} · Last updated {fmtDateTime(business.updated_at)}{business.website && <> · <a href={business.website} rel="noopener noreferrer" target="_blank">{business.website.replace(/^https?:\/\//, '')}</a></>}</p>
  {notice && <p class="message ok" role="status">{notice}</p>}
  {error && <p class="message" role="alert">{error}</p>}

  <div class="grid">
    <div class="col">
      <section class="card">
        <h2><Users />Members <span class="meta">({members.length})</span></h2>
        {members.length === 0 ? <p class="muted">No one yet.</p> : <ul class="members">
          {members.map((m) => <li>
            <div class="who">
              <a class="name" href={`/admin/users/${m.user_id}`}>{m.name}</a>
              {m.role === 'owner' && <span class="pill owner">Owner</span>}
              {m.staff_role && isStaffRole(m.staff_role) && <span class="pill staff">{ROLE_LABELS[m.staff_role]}</span>}
              <div class="meta">{m.email}{m.title && ` · ${m.title}`} · since {fmtDate(m.created_at)}</div>
            </div>
            <details>
              <summary>Edit</summary>
              <form class="inline" method="post" action="/api/admin/businesses">
                <input type="hidden" name="businessId" value={business.id} />
                <input type="hidden" name="userId" value={m.user_id} />
                <select name="role" aria-label="Role">{Object.entries(MEMBER_ROLE_LABELS).map(([key, label]) => <option value={key} selected={m.role === key}>{label}</option>)}</select>
                <input name="title" value={m.title ?? ''} maxlength="80" placeholder="Job title" aria-label="Job title" />
                <button class="button small" name="action" value="update-member" type="submit"><Check />Save</button>
                <button class="button secondary small" name="action" value="remove-member" type="submit"><UserMinus />Remove</button>
              </form>
            </details>
          </li>)}
        </ul>}
        {archived ? <p class="meta" style="margin-bottom:0">Restore this business to add members.</p> :
        <form class="form add" method="post" action="/api/admin/businesses">
          <h3>Add a member</h3>
          <input type="hidden" name="businessId" value={business.id} />
          <div class="add-row">
            <label>Account email <input name="email" type="email" required placeholder="person@example.com" /></label>
            <label>Role <select name="role">{Object.entries(MEMBER_ROLE_LABELS).map(([key, label]) => <option value={key} selected={key === 'member'}>{label}</option>)}</select></label>
            <label>Title <input name="title" maxlength="80" placeholder="Optional" /></label>
          </div>
          <div><button class="button small" name="action" value="add-member" type="submit"><UserPlus />Add member</button> <a class="meta" href="/admin/users/new">Need a new account?</a></div>
        </form>}
      </section>

      <section class="card">
        <h2><Megaphone />Ads <span class="meta">({ads.length})</span></h2>
        {ads.length === 0 ? <p class="muted">No ads yet.</p> : <ul class="members">
          {ads.slice(0, 8).map((a) => <li><div class="who"><a class="name" href={`/admin/ads/${a.id}`}>{a.name}</a><div class="meta">{STATE_LABELS[a.state]} · {a.impressions.toLocaleString('en-US')} impressions · {a.clicks.toLocaleString('en-US')} clicks</div></div></li>)}
        </ul>}
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:center;margin-top:1rem">
          {!archived && <a class="button small" href={`/admin/ads/new?business=${business.id}`}><Plus />New ad</a>}
          {ads.length > 0 && <a href={`/admin/ads?business=${business.id}`}>All ads for {business.name}</a>}
          <a href={`/business/${business.id}`}>Client dashboard</a>
        </div>
      </section>

      <section class="card">
        <h2><RotateCcwClock />Admin activity</h2>
        {audit.length === 0 ? <p class="muted" style="margin:0">No changes yet.</p> : <ul class="log">
          {audit.map((a) => <li><strong>{AUDIT_LABELS[a.action] ?? a.action}</strong>{a.target_user_id && <span> · {a.target_label}</span>}{a.detail && <span> — {a.detail}</span>}<div class="meta">{a.actor_name} · {fmtDateTime(a.created_at)}</div></li>)}
        </ul>}
      </section>
    </div>

    <div class="col">
      <section class="card">
        <h2><Info />Details</h2>
        <BusinessForm values={values} errors={errors} submitLabel="Save details" />
      </section>

      <section class="card danger">
        <h2><Archive />{archived ? 'Archived' : 'Archive or delete'}</h2>
        <form method="post" action="/api/admin/businesses">
          <input type="hidden" name="businessId" value={business.id} />
          {archived
            ? <button class="button small" name="action" value="restore" type="submit"><ArchiveRestore />Restore business</button>
            : <button class="button secondary small" name="action" value="archive" type="submit"><Archive />Archive business</button>}
          <p class="meta">Archiving hides a business from pickers but keeps its members and history. Use it for former clients.</p>
        </form>
        <details>
          <summary>Delete business</summary>
          <form class="form" method="post" action="/api/admin/businesses" style="margin-top:.8rem">
            <input type="hidden" name="businessId" value={business.id} />
            <p class="meta" style="margin:0">Permanently deletes the business and its member list. The people’s accounts aren’t affected.</p>
            <label>Type <code>{business.name}</code> to confirm <input name="confirm" required autocomplete="off" spellcheck="false" /></label>
            <div><button class="button small warn" name="action" value="delete" type="submit"><Trash />Delete permanently</button></div>
          </form>
        </details>
      </section>
    </div>
  </div>
</AdminLayout>

<style>
  .message.ok { border-color: var(--ok-line); color: var(--ok); background: var(--ok-bg); }
  .grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 1.25rem; margin-top: 1.25rem; align-items: start; }
  .col { display: grid; gap: 1.25rem; min-width: 0; }
  .card h2 { margin: 0 0 1rem; font-size: 1.15rem; }
  .card h3 { margin: 0; font-size: 1rem; }
  .pill { display: inline-block; padding: .15rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 700; white-space: nowrap; margin-left: .35rem; }
  .pill.owner { background: var(--alert-bg); color: var(--alert); }
  .pill.staff { background: var(--shoal); color: var(--deep); }
  .name { font-weight: 700; color: var(--deep); text-decoration: none; }
  .name:hover { color: var(--channel); text-decoration: underline; }
  ul.members, ul.log { list-style: none; margin: 0; padding: 0; }
  ul.members li, ul.log li { padding: .75rem 0; border-top: 1px solid var(--line-soft); }
  ul.members li:first-child, ul.log li:first-child { border-top: 0; padding-top: 0; }
  ul.members li { display: flex; justify-content: space-between; align-items: start; gap: .75rem; flex-wrap: wrap; }
  .who { min-width: 0; overflow-wrap: anywhere; }
  details summary { cursor: pointer; font-weight: 700; color: var(--channel); }
  .danger details summary { margin-top: .8rem; }
  form.inline { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem; }
  form.inline select, form.inline input { padding: .45rem .6rem; border: 1px solid var(--field); border-radius: 3px; background: #fff; font: inherit; font-size: .9rem; }
  .add { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .add-row { display: grid; grid-template-columns: 2fr 1fr 1.5fr; gap: .75rem; }
  .button.warn { background: var(--warn); border-color: var(--warn); }
  .button.warn:hover { background: var(--warn-2); border-color: var(--warn-2); }
  .danger { border-color: var(--alert-line); }
  @media (max-width: 1000px) { .grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) { .add-row { grid-template-columns: minmax(0, 1fr); } }
</style>
