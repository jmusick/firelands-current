---
import BaseLayout from '../layouts/BaseLayout.astro';
import Turnstile from '../components/Turnstile.astro';
if (Astro.locals.user) return Astro.redirect('/account');
---
<BaseLayout title="Forgot password">
  <h1>Forgot your password?</h1>
  <p class="lede">Enter the email address on your account and we'll send a link to choose a new password.</p>
  <form id="forgot-form" class="form">
    <label>Email address <input name="email" type="email" required autocomplete="email" /></label>
    <Turnstile />
    <div id="form-message" class="message" role="alert" hidden></div>
    <button class="button" type="submit">Send reset link</button>
  </form>
  <p>Remembered it? <a href="/sign-in">Sign in</a>.</p>
  <script>
    import { authClient } from '../lib/auth-client';
    import { captchaHeaders, resetCaptcha } from '../lib/turnstile-client';
    import { NETWORK_ERROR } from '../lib/auth-errors';
    const form = document.querySelector<HTMLFormElement>('#forgot-form')!;
    const message = document.querySelector<HTMLElement>('#form-message')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;
      const email = String(new FormData(form).get('email') ?? '').trim();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      let result;
      try {
        result = await authClient.requestPasswordReset({ email, redirectTo: '/reset-password' }, { headers: captchaHeaders(form) });
      } catch {
        message.textContent = NETWORK_ERROR; message.hidden = false; resetCaptcha(); button.disabled = false; return;
      }
      button.disabled = false;
      if (result.error) { message.textContent = result.error.message || 'Could not send the reset link.'; message.hidden = false; resetCaptcha(); return; }
      // Same answer whether or not the address has an account, so this can't be used to look people up.
      message.textContent = 'If an account uses that address, a reset link is on its way. It works for one hour.';
      message.hidden = false;
      form.reset();
      resetCaptcha();
    });
  </script>
</BaseLayout>
