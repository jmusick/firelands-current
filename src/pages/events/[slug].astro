---
import { CalendarPlus, Clock, ExternalLink, MapPin, Ticket, Users } from '@lucide/astro';
import Comments from '../../components/Comments.astro';
import CorrectionLink from '../../components/CorrectionLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adPlanFor } from '../../lib/ads';
import { getEventThread } from '../../lib/forum';
import { CATEGORIES, TICKET_AVAILABILITY, eventJsonLd, fmtDates, fullHours, getEvent, isPast, mapsUrl } from '../../lib/events';
import { mediaByKeys, mediaKeysIn } from '../../lib/media';
import { figureHtml, leadMedia, renderBodyBlocks } from '../../lib/news';

const event = await getEvent(Astro.params.slug ?? '');
if (!event) return new Response('Event not found', { status: 404 });
await adPlanFor(Astro.request, Astro.locals);
const thread = await getEventThread(event.id, Astro.locals.user?.id ?? '');

const image = leadMedia(event);
const details = event.description ? renderBodyBlocks(event.description, await mediaByKeys(mediaKeysIn(event.description))).join('') : '';
const pageUrl = new URL(`/events/${event.slug}`, Astro.url.origin).href;
const imageUrl = image ? new URL(`/media/${image.object_key}`, Astro.url.origin).href : null;
const cancelled = event.status === 'cancelled';
const over = isPast(event);
---
<BaseLayout title={event.title} description={event.summary} image={image && { url: `/media/${image.object_key}`, width: image.width, height: image.height, alt: image.alt }}>
  <script slot="head" type="application/ld+json" set:html={eventJsonLd(event, pageUrl, imageUrl)} />
  <article class="event">
    <span class="eyebrow">{event.community}<a class="section" href={`/events?category=${event.category}`}>{CATEGORIES[event.category]}</a></span>
    <h1 class:list={{ struck: cancelled }}>{event.title}</h1>
    {cancelled && <p class="message" role="status"><strong>This event has been cancelled.</strong></p>}
    {!cancelled && over && <p class="notice">This event has already taken place.</p>}
    <p class="lede" style="margin-top:0">{event.summary}</p>

    <dl class="facts">
      <div><dt><Clock />When</dt><dd>{fmtDates(event, { year: true })}<br />{fullHours(event)}{event.ends_on && event.start_time && !event.hours_note && <span class="meta"> each day</span>}</dd></div>
      <div><dt><MapPin />Where</dt><dd>{event.venue}<br />{event.address ? `${event.address}, ${event.community}` : event.community}<br /><a href={mapsUrl(event)} rel="noopener">Map</a></dd></div>
      {event.cost && <div><dt><Ticket />Cost</dt><dd>{event.cost}</dd></div>}
      {event.ticket_price !== '' && <div><dt><Ticket />Admission</dt><dd>{Number(event.ticket_price) === 0 ? 'Free' : `From ${Number(event.ticket_price).toLocaleString('en-US', { style: 'currency', currency: 'USD' })}`}{event.ticket_availability && <><br />{TICKET_AVAILABILITY[event.ticket_availability]}</>}</dd></div>}
      {event.organizer && <div><dt><Users />Organizer</dt><dd>{event.organizer_url ? <a href={event.organizer_url} rel="noopener">{event.organizer}</a> : event.organizer}</dd></div>}
      {event.performer && <div><dt><Users />Performer</dt><dd>{event.performer}</dd></div>}
    </dl>
    <div class="actions">
      {!cancelled && !over && <a class="button" href={`/events/${event.slug}.ics`} download={`${event.slug}.ics`}><CalendarPlus />Add to calendar</a>}
      {event.link && <a class="button secondary" href={event.link} rel="noopener">More details<ExternalLink /></a>}
      {event.ticket_url && <a class="button secondary" href={event.ticket_url} rel="noopener"><Ticket />Tickets / registration</a>}
    </div>

    {image && <Fragment set:html={figureHtml(image, { className: 'story-figure', eager: true })} />}
    {details && <div class="story"><Fragment set:html={details} /></div>}
    <CorrectionLink kind="event" slug={event.slug} />
  </article>
  {thread && <div style="max-width:760px"><Comments thread={thread} path={`/events/${event.slug}`} /><p><a href={`/talk/${thread.id}`}>Also in Talk of the Town</a></p></div>}
  <p style="margin-top:2.5rem"><a href="/events">See everything on the calendar</a></p>
</BaseLayout>

<style>
  .event { max-width: 760px; }
  .event h1 { font-stretch: 66%; line-height: 1; margin-top: .35rem; }
  .eyebrow a.section { text-decoration: none; }
  .eyebrow a.section:hover { color: var(--channel); text-decoration: underline; }
  .struck { text-decoration: line-through; text-decoration-thickness: 2px; color: var(--slate); }
  .notice { padding: .7rem 1rem; background: var(--shoal); border-left: 4px solid var(--slate); color: #33474c; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.1rem 2rem; margin: 1.5rem 0; padding: 1.2rem 1.3rem; background: var(--shoal); border-top: 3px solid var(--deep); }
  .facts dt { display: flex; align-items: center; gap: .4rem; font-size: .95rem; font-weight: 700; color: var(--deep); }
  .facts dt :global(.lucide) { width: 1.05rem; height: 1.05rem; color: var(--channel); }
  .facts dd { margin: .3rem 0 0; line-height: 1.5; }
  .actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .actions .button { display: inline-flex; align-items: center; gap: .45rem; }
  .actions :global(.lucide) { width: 1.1em; height: 1.1em; }
  .story { font-family: var(--read); font-size: 1.2rem; line-height: 1.65; max-width: 36em; }
  .story :global(img) { max-width: 100%; height: auto; }
  .story :global(ul), .story :global(ol) { padding-left: 1.4rem; }
  :global(.story-figure) { margin: 0 0 2rem; }
  :global(.story-figure img) { display: block; width: 100%; height: auto; background: var(--shoal); }
  :global(.story-figure figcaption) { margin-top: .6rem; font-size: .92rem; line-height: 1.45; color: #33474c; }
  :global(.story-figure .credit) { color: var(--slate); font-size: .85rem; }
</style>
