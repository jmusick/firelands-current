---
import AuthorLink from '../components/AuthorLink.astro';
import AdSlot from '../components/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fmtStoryDate as fmtDate, isoDateTime } from '../lib/dates';
import { CATEGORIES, fmtDay, fmtHours, listEvents, today } from '../lib/events';
import { SECTIONS, articlesBySection, frontPageArticles, leadMedia } from '../lib/news';

const { lead, more } = await frontPageArticles();
// Only the lead is left out: the rail is a newest-first list, and skipping it would leave sections short.
const sections = await articlesBySection(3, lead ? [lead.id] : []);
const leadImage = lead ? leadMedia(lead) : null;
const events = (await listEvents({}, 0, 4)).slice(0, 4);
const now = today();
---
<BaseLayout title="Sandusky & Firelands Local News">
  {lead ? <section class="front">
    <article class="lead">
      {leadImage && <figure class="front-photo">
        <a class="front-image" href={`/news/${lead.slug}`} tabindex="-1" aria-hidden="true"><img src={`/media/${leadImage.object_key}`} alt="" width={leadImage.width} height={leadImage.height} fetchpriority="high" /></a>
        <figcaption>{leadImage.caption} {leadImage.credit} <a href={`/news/${lead.slug}`}>Photo details</a></figcaption>
      </figure>}
      <span class="eyebrow">{lead.community}<span class="section">{SECTIONS[lead.section]}</span></span>
      <h1><a href={`/news/${lead.slug}`}>{lead.headline}</a></h1>
      <p class="lede">{lead.summary}</p>
      <p class="meta">By <AuthorLink id={lead.author_id} name={lead.byline} />, <time datetime={isoDateTime(lead.published_at)}>{fmtDate(lead.published_at)}</time></p>
    </article>
    <div class="rail">
      <h2>Latest</h2>
      {more.map((article) => <article>
        <span class="eyebrow">{article.community}<span class="section">{SECTIONS[article.section]}</span></span>
        <h3><a href={`/news/${article.slug}`}>{article.headline}</a></h3>
        <p class="meta"><time datetime={isoDateTime(article.published_at)}>{fmtDate(article.published_at)}</time></p>
      </article>)}
      <p class="more"><a href="/news">All the latest news</a></p>
      <AdSlot placement="home-rail" class="home-rail" />
    </div>
  </section> : <section class="empty-front">
    <h1>The region's stories belong here.</h1>
    <p class="lede">Firelands Current is taking shape as an independent home for news and conversation centered on Sandusky and the communities around it.</p>
    <a class="button" href="/talk">Visit Talk of the Town</a>
  </section>}
  <div class="home-billboard"><AdSlot placement="home-billboard" /></div>
  {events.length > 0 && <section class="coming-up" aria-labelledby="coming-up">
    <div class="band-head"><h2 id="coming-up">Coming up</h2><a href="/events">Full events calendar</a></div>
    <div class="coming-up-list">
      {events.map((e) => {
        const day = e.starts_on < now ? now : e.starts_on;
        return <article class:list={{ today: day === now, cancelled: e.status === 'cancelled' }}>
          <p class="date"><span class="num">{Number(day.slice(8, 10))}</span><span class="rest">{day === now ? 'Today' : fmtDay(day, { weekday: 'short' })}<br />{fmtDay(day, { month: 'short' })}</span></p>
          <div>
            <h3><a href={`/events/${e.slug}`}>{e.title}</a></h3>
            <p class="meta">{e.status === 'cancelled' ? <strong>Cancelled</strong> : fmtHours(e)}, {e.venue}, {e.community}</p>
            <p class="meta category">{CATEGORIES[e.category]}</p>
          </div>
        </article>;
      })}
    </div>
  </section>}
  {sections.length > 0 && <div class="sections">
    {sections.map(({ section, articles }) => <section class="news-section" aria-labelledby={`sec-${section}`}>
      <div class="band-head"><h2 id={`sec-${section}`}>{SECTIONS[section]}</h2><a href={`/news?section=${section}`}>More {SECTIONS[section]}</a></div>
      {articles.map((a) => <article>
        <h3><a href={`/news/${a.slug}`}>{a.headline}</a></h3>
        <p class="meta">{a.community}, <time datetime={isoDateTime(a.published_at)}>{fmtDate(a.published_at)}</time></p>
      </article>)}
    </section>)}
  </div>}
  <section class="about" aria-label="About Firelands Current">
    <div><h2><a href="/news">News with a local address</a></h2><p>Coverage begins with Sandusky and extends across roughly 50 miles of the Firelands region.</p></div>
    <div><h2><a href="/events">Local events</a></h2><p>Concerts, festivals, markets and public meetings around Sandusky and the Firelands.</p></div>
    <div><h2><a href="/talk">Talk of the Town</a></h2><p>Start a discussion, share what is happening, and hear from neighbors. A free account is needed to post.</p></div>
  </section>
</BaseLayout>

<style>
  .front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 3rem; padding-bottom: 2.5rem; }
  .lead { min-width: 0; }
  .lead h1 { margin: .35rem 0 .9rem; font-size: clamp(2.6rem, 6.2vw, 4.75rem); font-stretch: 66%; line-height: .98; letter-spacing: -.015em; }
  .lead h1 a, .rail h3 a, .news-section h3 a, .coming-up h3 a { color: inherit; text-decoration: none; }
  .lead h1 a:hover, .rail h3 a:hover, .news-section h3 a:hover, .coming-up h3 a:hover { color: var(--channel); }
  .lead .lede { margin: 0 0 .9rem; font-size: clamp(1.2rem, 2.4vw, 1.4rem); }
  .lead .meta { margin: 0; }
  .front-photo { margin: 0 0 1.2rem; }
  .front-photo figcaption { margin-top: .5rem; font-family: var(--scan); font-size: .85rem; line-height: 1.45; color: var(--slate); }
  .front-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--shoal); }
  .rail { min-width: 0; border-left: 1px solid var(--line); padding-left: 2rem; }
  .rail h2 { margin: 0 0 .4rem; font-size: 1.1rem; font-stretch: 90%; color: var(--slate); }
  .rail article { padding: 1rem 0; border-top: 1px solid var(--line-soft); }
  .rail h3 { margin: .25rem 0 .3rem; font-size: 1.35rem; }
  .rail .meta, .news-section .meta { margin: 0; }
  .rail .more { margin: .5rem 0 0; font-weight: 600; }
  .empty-front { max-width: 850px; padding: 1rem 0 3rem; }
  .home-billboard { padding: .5rem 0 0; }

  .band-head { display: flex; justify-content: space-between; align-items: baseline; gap: .4rem 1rem; flex-wrap: wrap; border-top: 3px solid var(--deep); padding-top: .6rem; }
  .band-head h2 { margin: 0 0 .6rem; }
  .band-head a { font-weight: 600; font-size: .95rem; }

  /* The calendar gets the page's one tinted band, full-bleed without causing horizontal scroll. */
  .coming-up { margin-top: 3rem; padding: 2rem 0 2.2rem; background: var(--shoal); box-shadow: 0 0 0 100vmax var(--shoal); clip-path: inset(0 -100vmax); }
  .coming-up .band-head { border-top: 0; padding-top: 0; }
  .coming-up-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem 2rem; margin-top: .6rem; }
  .coming-up-list article { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); gap: .9rem; min-width: 0; }
  .date { margin: 0; display: grid; justify-items: start; align-content: start; padding-top: .15rem; border-top: 3px solid var(--deep); color: var(--deep); }
  .today .date { border-top-color: var(--sunset); }
  .date .num { font-weight: 800; font-stretch: 62%; font-size: 3rem; line-height: .95; font-variant-numeric: tabular-nums; }
  .date .rest { font-size: .85rem; font-weight: 600; line-height: 1.2; }
  .coming-up h3 { margin: .2rem 0 .35rem; font-size: 1.3rem; }
  .coming-up .meta { margin: 0; }
  .coming-up .category { margin-top: .2rem; font-size: .85rem; }
  .cancelled h3 a { text-decoration: line-through; color: var(--slate); }

  .sections { padding-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 2.5rem 2.5rem; }
  .news-section { min-width: 0; }
  .news-section article { padding: .9rem 0; border-bottom: 1px solid var(--line-soft); }
  .news-section article:last-child { border-bottom: 0; }
  .news-section h3 { margin: 0 0 .3rem; font-size: 1.3rem; }

  .about { margin-top: 3.5rem; padding-top: 1.8rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem 2.5rem; }
  .about h2 { margin: 0 0 .4rem; font-size: 1.45rem; }
  .about h2 a { color: var(--deep); text-decoration: none; }
  .about h2 a:hover { color: var(--channel); text-decoration: underline; }
  .about p { margin: 0; font-family: var(--read); font-size: 1.05rem; line-height: 1.5; color: var(--slate); max-width: 34em; }
  .rail :global(.home-rail) { margin-top: 2rem; }
  @media (max-width: 860px) {
    .front { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .rail { border-left: 0; padding-left: 0; border-top: 3px solid var(--deep); padding-top: .6rem; }
  }
</style>
