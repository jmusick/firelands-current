---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAX_PASSWORD, MIN_PASSWORD, PASSWORD_HINT } from '../lib/password-policy';
if (Astro.locals.user) return Astro.redirect('/account');
// Better Auth sends people here with ?token=… after checking the link, or ?error=INVALID_TOKEN.
const token = Astro.url.searchParams.get('token');
const failed = Astro.url.searchParams.get('error') || !token;
---
<BaseLayout title="Choose a new password">
  <h1>Choose a new password</h1>
  {failed ? (
    <p class="message" role="alert">This reset link is invalid or has expired. <a href="/forgot-password">Request a new one</a>.</p>
  ) : (
    <form id="reset-form" class="form" data-token={token}>
      <label>New password <input name="password" type="password" required minlength={MIN_PASSWORD} maxlength={MAX_PASSWORD} autocomplete="new-password" /><span class="muted" style="font-weight:400">{PASSWORD_HINT}</span></label>
      <div id="form-message" class="message" role="alert" hidden></div>
      <button class="button" type="submit">Change password</button>
    </form>
  )}
  <script>
    import { authClient } from '../lib/auth-client';
    import { NETWORK_ERROR } from '../lib/auth-errors';
    const form = document.querySelector<HTMLFormElement>('#reset-form');
    const message = document.querySelector<HTMLElement>('#form-message');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      message!.hidden = true;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      let result;
      try {
        result = await authClient.resetPassword({ newPassword: String(new FormData(form).get('password') ?? ''), token: form.dataset.token! });
      } catch {
        message!.textContent = NETWORK_ERROR; message!.hidden = false; button.disabled = false; return;
      }
      button.disabled = false;
      if (result.error) { message!.textContent = result.error.message || 'Could not change your password.'; message!.hidden = false; return; }
      window.location.assign('/sign-in?reset=1');
    });
  </script>
</BaseLayout>
