---
import AuthorLink from '../../components/AuthorLink.astro';
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adPlanFor, feedAdBreaks } from '../../lib/ads';
import { fmtStoryDate, isoDateTime } from '../../lib/dates';
import { SECTIONS, isSection, listArticles } from '../../lib/news';

const sectionParam = Astro.url.searchParams.get('section');
const section = isSection(sectionParam) ? sectionParam : undefined;
const requestedPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 && requestedPage <= 10000 ? requestedPage : 1;
const fetched = await listArticles(page - 1, section);
const hasMore = fetched.length > 20;
const articles = fetched.slice(0, 20);
await adPlanFor(Astro.request, Astro.locals, { section });
const adAfter = new Set(feedAdBreaks(articles.length));
const pageHref = (n: number) => {
  const params = new URLSearchParams();
  if (section) params.set('section', section);
  if (n > 1) params.set('page', String(n));
  const query = params.toString();
  return query ? `/news?${query}` : '/news';
};
---
<BaseLayout title={section ? SECTIONS[section] : 'News'} description="Local news from Sandusky and communities across the Firelands." canonicalPath={pageHref(page)}>
  <h1>{section ? SECTIONS[section] : 'Latest news'}</h1>
  <nav aria-label="News sections" class="filter-tabs">
    <a href="/news" aria-current={section ? undefined : 'page'}>All</a>
    {Object.entries(SECTIONS).map(([key, label]) => <a href={`/news?section=${key}`} aria-current={section === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div>
    {articles.length === 0 ? <div class="card" style="margin-top:1rem"><h2>No stories yet</h2><p class="muted">Check back soon for reporting from around the region.</p></div> : articles.map((article, i) => <><article class="item"><div class="text"><span class="eyebrow">{article.community}{!section && <span class="section">{SECTIONS[article.section]}</span>}</span><h2><a href={`/news/${article.slug}`}>{article.headline}</a></h2><p class="summary">{article.summary}</p><p class="meta">By <AuthorLink id={article.author_id} name={article.byline} />, <time datetime={isoDateTime(article.published_at)}>{fmtStoryDate(article.published_at)}</time></p></div>{article.lead_key && <a class="thumb" href={`/news/${article.slug}`} tabindex="-1" aria-hidden="true"><img src={`/media/${article.lead_key}`} alt="" width={article.lead_width!} height={article.lead_height!} loading="lazy" /></a>}</article>{adAfter.has(i + 1) && <AdSlot placement="news-feed" />}</>)}
  </div>
  {(page > 1 || hasMore) && <nav aria-label="News pages" style="display:flex;justify-content:space-between;margin-top:1.5rem"><span>{page > 1 && <a href={pageHref(page - 1)}>← Newer stories</a>}</span><span>{hasMore && <a href={pageHref(page + 1)}>Older stories →</a>}</span></nav>}
</BaseLayout>

<style>
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.75rem; align-items: start; padding: 1.5rem 0; border-bottom: 1px solid var(--line-soft); }
  .text { min-width: 0; }
  .item h2 { margin: .3rem 0 .45rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .item h2 a { color: inherit; text-decoration: none; }
  .item h2 a:hover { color: var(--channel); }
  .summary { max-width: 36em; margin: 0 0 .5rem; font-family: var(--read); font-size: 1.1rem; line-height: 1.5; color: #33474c; }
  .item .meta { margin: 0; }
  .thumb img { display: block; width: 240px; aspect-ratio: 3 / 2; height: auto; object-fit: cover; background: var(--shoal); margin-top: .3rem; }
  @media (max-width: 640px) { .thumb img { width: 110px; } .item { gap: 1rem; } }
</style>
