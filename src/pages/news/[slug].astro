---
import AuthorBio from '../../components/AuthorBio.astro';
import AuthorLink from '../../components/AuthorLink.astro';
import { getStaffBio } from '../../lib/bios';
import AdSlot from '../../components/AdSlot.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Comments from '../../components/Comments.astro';
import CorrectionLink from '../../components/CorrectionLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adPlanFor, inlineAdBreaks } from '../../lib/ads';
import { getArticleThread } from '../../lib/forum';
import { mediaByKeys, mediaKeysIn } from '../../lib/media';
import { SECTIONS, figureHtml, getArticle, leadMedia, newsArticleJsonLd, relatedArticles, renderBodyBlocks } from '../../lib/news';

const article = await getArticle(Astro.params.slug ?? '');
if (!article) return new Response('Story not found', { status: 404 });
await adPlanFor(Astro.request, Astro.locals, { section: article.section });
const related = await relatedArticles(article);
const thread = await getArticleThread(article.id, Astro.locals.user?.id ?? '');
const authorBio = await getStaffBio(article.author_id);

// Split the story into chunks with an ad between each. A break never lands right under a subheading.
const lead = leadMedia(article);
const blocks = renderBodyBlocks(article.body, await mediaByKeys(mediaKeysIn(article.body)));
const chunks: string[] = [];
let start = 0;
for (let at of inlineAdBreaks(blocks.length)) {
  while (at < blocks.length - 1 && /^<h\d/.test(blocks[at - 1])) at++;
  if (at <= start || at >= blocks.length) continue;
  chunks.push(blocks.slice(start, at).join(''));
  start = at;
}
chunks.push(blocks.slice(start).join(''));
---
<BaseLayout title={article.headline} description={article.summary.slice(0, 155)} type="article" image={lead && { url: `/media/${lead.object_key}`, width: lead.width, height: lead.height, alt: lead.alt }}>
  <script slot="head" type="application/ld+json" set:html={newsArticleJsonLd(article, Astro.url.origin)} />
  <div class="story-layout">
  <article style="max-width:760px;min-width:0">
    <span class="eyebrow">{article.community}<a class="section" href={`/news?section=${article.section}`}>{SECTIONS[article.section]}</a></span>
    <h1 class="headline">{article.headline}</h1>
    <p class="lede" style="margin-top:0">{article.summary}</p>
    <p class="meta byline">By <strong><AuthorLink id={article.author_id} name={article.byline} /></strong><br />{new Date(article.published_at).toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' })}</p>
    <AuthorBio name={article.byline} bio={authorBio} />
    <ShareButtons url={new URL(`/news/${article.slug}`, Astro.url.origin).href} title={article.headline} />
    {lead && <Fragment set:html={figureHtml(lead, { className: 'story-figure lead', eager: true })} />}
    <div class="story">
      {chunks.map((html, i) => <>{i > 0 && <AdSlot placement="article-inline" class="story-ad" />}<Fragment set:html={html} /></>)}
    </div>
    <ShareButtons url={new URL(`/news/${article.slug}`, Astro.url.origin).href} title={article.headline} />
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related coverage</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/news/${r.slug}`}>{r.headline}</a>
              <span class="meta">{SECTIONS[r.section]} &middot; <time datetime={new Date(r.published_at).toISOString()}>{new Date(r.published_at).toLocaleDateString('en-US', { dateStyle: 'medium' })}</time></span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <CorrectionLink kind="news" slug={article.slug} />
  </article>
  <div class="story-rail"><AdSlot placement="article-rail" /></div>
  </div>
  {thread && <div style="max-width:760px"><Comments thread={thread} path={`/news/${article.slug}`} /><p><a href={`/talk/${thread.id}`}>Also in Talk of the Town</a></p></div>}
</BaseLayout>

<style>
  .story-layout { display: grid; grid-template-columns: minmax(0, 760px) 300px; justify-content: space-between; gap: 3rem; }
  .eyebrow a.section { text-decoration: none; }
  .eyebrow a.section:hover { color: var(--channel); text-decoration: underline; }
  .headline { font-size: clamp(2.4rem, 5.6vw, 3.9rem); font-stretch: 66%; line-height: 1; margin: .35rem 0 1rem; }
  .byline { margin: 1.4rem 0 0; padding-top: .8rem; border-top: 3px solid var(--deep); line-height: 1.45; }
  .byline strong { color: var(--ink); font-weight: 650; }
  .related { margin: 2.4rem 0 1.5rem; padding-top: .8rem; border-top: 3px solid var(--deep); }
  .related h2 { margin: 0 0 .6rem; font-size: 1.3rem; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li { padding: .65rem 0; border-top: 1px solid var(--line-soft); line-height: 1.35; }
  .related li:first-child { border-top: 0; }
  .related li a { display: block; font-weight: 650; }
  .related .meta { display: block; margin-top: .15rem; font-size: .9rem; }
  .story-rail { padding-top: .5rem; }
  .story-rail :global(.ad-slot) { position: sticky; top: 1.5rem; }
  .story :global(.story-ad) { margin: 2rem auto; padding: 1rem 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); width: 100%; max-width: none; line-height: normal; font-family: var(--scan); font-size: 1rem; }
  .story :global(.story-ad .ad-creative) { width: 300px; max-width: 100%; }
  @media (max-width: 1100px) { .story-layout { grid-template-columns: minmax(0, 1fr); } .story-rail { display: none; } }
  /* About 70 characters a line at this size; serif text gets a little more leading than the sans would. */
  .story { font-family: var(--read); font-size: 1.22rem; line-height: 1.65; max-width: 36em; }
  .story :global(p) { margin: 0 0 1.1em; }
  .story :global(h2), .story :global(h3) { margin: 2.2rem 0 .6rem; }
  .story :global(blockquote) { margin: 1.8rem 0; padding: .1rem 0 .1rem 1.3rem; border-left: 3px solid var(--channel); color: #33474c; font-style: italic; font-size: 1.1em; }
  .story :global(img) { max-width: 100%; height: auto; vertical-align: middle; }
  :global(.story-figure) { margin: 2rem 0; }
  :global(.story-figure.lead) { margin: 0 0 1.8rem; }
  :global(.story-figure img) { display: block; width: 100%; height: auto; background: var(--shoal); }
  :global(.story-figure figcaption) { margin-top: .6rem; font-family: var(--scan); font-size: .92rem; line-height: 1.45; color: #33474c; }
  :global(.story-figure .credit) { color: var(--slate); font-size: .85rem; }
  .story :global(ul), .story :global(ol) { padding-left: 1.4rem; }
</style>
