---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialButtons from '../components/SocialButtons.astro';
import Turnstile from '../components/Turnstile.astro';
import { MAX_PASSWORD, MIN_PASSWORD, PASSWORD_HINT } from '../lib/password-policy';
if (Astro.locals.user) return Astro.redirect('/account');
---
<BaseLayout title="Create an account">
  <h1>Create an account</h1>
  <p class="lede">Your account has its own Firelands Current ID. Use it to join Talk of the Town and, later, other community features.</p>
  <form id="register-form" class="form">
    <label>Display name <input name="name" required minlength="2" maxlength="60" autocomplete="nickname" /></label>
    <label>Email address <input name="email" type="email" required autocomplete="email" /></label>
    <label>Password <input name="password" type="password" required minlength={MIN_PASSWORD} maxlength={MAX_PASSWORD} autocomplete="new-password" /><span class="muted" style="font-weight:400">{PASSWORD_HINT}</span></label>
    <Turnstile />
    <div id="form-message" class="message" role="alert" hidden></div>
    <button class="button" type="submit">Create account</button>
  </form>
  <div id="check-email" class="card" style="max-width:650px" hidden>
    <h2 style="margin-top:0">Check your email</h2>
    <p>We sent a confirmation link to <strong id="sent-to"></strong>. Open it to finish creating your account. The link works for one hour.</p>
    <p class="meta">Nothing there? Check your spam folder, or <a href="/sign-in">try signing in</a> to have a new link sent.</p>
  </div>
  <SocialButtons verb="Sign up" />
  <p>Already registered? <a href="/sign-in">Sign in</a>.</p>
  <p class="meta">By creating an account you agree to our <a href="/terms">Terms of Service</a>. See our <a href="/privacy">Privacy Policy</a> for how we handle your information.</p>
  <style>
    /* .form sets display: grid, which would otherwise win over the hidden attribute. */
    .form[hidden] { display: none; }
  </style>
  <script>
    import { authClient } from '../lib/auth-client';
    import { captchaHeaders, resetCaptcha } from '../lib/turnstile-client';
    import { NETWORK_ERROR } from '../lib/auth-errors';
    import { queueSignUp } from '../scripts/outcome-events';
    const form = document.querySelector<HTMLFormElement>('#register-form')!;
    const message = document.querySelector<HTMLElement>('#form-message')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      if (name.length < 2 || name.length > 60) { message.textContent = 'Use a display name between 2 and 60 characters.'; message.hidden = false; return; }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      let result;
      try {
        result = await authClient.signUp.email({ name, email, password, callbackURL: '/account?verified=1' }, { headers: captchaHeaders(form) });
      } catch {
        message.textContent = NETWORK_ERROR; message.hidden = false; resetCaptcha(); button.disabled = false; return;
      }
      button.disabled = false;
      if (result.error) { message.textContent = result.error.message || 'Could not create your account.'; message.hidden = false; resetCaptcha(); return; }
      queueSignUp('email');
      document.querySelector<HTMLElement>('#sent-to')!.textContent = email;
      form.hidden = true;
      document.querySelector<HTMLElement>('#check-email')!.hidden = false;
      document.querySelector<HTMLElement>('.lede')!.hidden = true;
    });
  </script>
</BaseLayout>
