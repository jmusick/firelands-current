---
import { FORMAT_IMAGES, type Ad, type AdFormat } from '../lib/ads';

// The ad itself, without its label or tracking: used by live slots and by admin/client previews.
interface Props {
  ad: Ad;
  format: AdFormat;
  href: string;
  /** Previews show every size at once, so they skip the phone/desktop switch. */
  viewport?: 'responsive' | 'desktop' | 'mobile';
}

const { ad, format, href, viewport = 'responsive' } = Astro.props;
const rel = ad.kind === 'booked' ? 'sponsored noopener' : undefined;
const style = `--ad-bg:${ad.theme.bg};--ad-fg:${ad.theme.fg};--ad-accent:${ad.theme.accent}`;
const sizes = format === 'native' ? null : FORMAT_IMAGES[format];
const desktop = sizes && viewport !== 'mobile' ? ad.images[sizes.desktop] : undefined;
const mobile = sizes && viewport !== 'desktop' ? ad.images[sizes.mobile] : undefined;
const alt = `${ad.advertiser}: ${ad.headline}`;
---
{format === 'native' ? (
  <div class="ad-native-body" data-preview-theme>
    <h2><a href={href} rel={rel} data-preview="headline">{ad.headline}</a></h2>
    <p class="muted"><span data-preview="body">{ad.body}</span> <a href={href} rel={rel} tabindex="-1"><span data-preview="cta">{ad.cta}</span> →</a></p>
  </div>
) : (
  <a class:list={['ad-creative', `ad-${format}`, `vp-${viewport}`, { 'has-desktop': desktop || (viewport === 'mobile' && mobile), 'has-mobile': mobile || (viewport === 'desktop' && desktop) }]} href={href} rel={rel} style={style} data-preview-theme>
    {desktop && <img class="ad-img ad-img-desktop" src={desktop.url} alt={alt} width={desktop.width} height={desktop.height} loading="lazy" decoding="async" />}
    {mobile && <img class="ad-img ad-img-mobile" src={mobile.url} alt={alt} width={mobile.width} height={mobile.height} loading="lazy" decoding="async" />}
    <span class="ad-text">
      <span class="ad-advertiser">{ad.advertiser}</span>
      <span class="ad-headline" data-preview="headline">{ad.headline}</span>
      <span class="ad-body" data-preview="body">{ad.body}</span>
      <span class="ad-cta" data-preview="cta">{ad.cta}</span>
    </span>
  </a>
)}

<style>
  .ad-creative { display: block; position: relative; width: 100%; overflow: hidden; text-decoration: none; border-radius: 3px; background: var(--ad-bg); color: var(--ad-fg); border: 1px solid color-mix(in srgb, var(--ad-fg) 18%, transparent); }
  .ad-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ad-img-mobile { display: none; }
  .ad-text { display: grid; align-content: center; gap: .25rem; height: 100%; padding: 1rem 1.2rem; }
  .has-desktop .ad-text { display: none; }
  .ad-creative:hover .ad-cta { filter: brightness(1.08); text-decoration: underline; }
  .ad-advertiser { font-size: .8rem; font-weight: 700; color: var(--ad-accent); }
  .ad-headline { font: 700 1.25rem/1.1 var(--scan); font-stretch: 78%; }
  .ad-body { font-size: .88rem; line-height: 1.4; opacity: .88; }
  .ad-cta { justify-self: start; margin-top: .35rem; background: var(--ad-accent); color: var(--ad-bg); font-weight: 700; font-size: .82rem; padding: .4rem .75rem; border-radius: 3px; }

  /* Sizes are reserved up front so slots never shift the page as they fill. Image creatives keep the exact height;
     text creatives only reserve it as a minimum, so enlarged text grows the box instead of being clipped. */
  .ad-creative { height: var(--ad-h); }
  .ad-creative:not(.has-desktop):not(.has-mobile) { height: auto; min-height: var(--ad-h); }
  .ad-leaderboard { --ad-h: 90px; }
  .ad-leaderboard .ad-text { grid-template-columns: auto 1fr auto; grid-template-rows: auto auto; column-gap: 1.2rem; row-gap: .1rem; padding: .7rem 1.2rem; }
  .ad-leaderboard .ad-advertiser { grid-column: 1; grid-row: 1 / 3; align-self: center; max-width: 9rem; }
  .ad-leaderboard .ad-headline { grid-column: 2; font-size: 1.1rem; }
  .ad-leaderboard .ad-body { grid-column: 2; font-size: .8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ad-leaderboard .ad-cta { grid-column: 3; grid-row: 1 / 3; align-self: center; margin: 0; white-space: nowrap; }

  .ad-rectangle { --ad-h: 250px; }
  .ad-rectangle .ad-text { padding: 1.4rem; }
  .ad-rectangle .ad-headline { font-size: 1.45rem; }

  .ad-billboard { --ad-h: 250px; }
  .ad-billboard .ad-text { padding: 2rem 2.5rem; background-image: radial-gradient(circle at 88% 50%, color-mix(in srgb, var(--ad-accent) 35%, transparent) 0 22%, transparent 22.5%); }
  .ad-billboard .ad-headline { font-size: clamp(1.5rem, 3.4vw, 2.3rem); max-width: 34rem; }
  .ad-billboard .ad-body { font-size: 1rem; max-width: 30rem; }

  /* Phone layout: used below 760px for live slots, and always for mobile previews. */
  @media (max-width: 760px) {
    .vp-responsive .ad-img-desktop { display: none; }
    .vp-responsive .ad-img-mobile { display: block; }
    .vp-responsive.has-desktop .ad-text { display: grid; }
    .vp-responsive.has-mobile .ad-text { display: none; }
    .vp-responsive.ad-leaderboard { --ad-h: 100px; }
    .vp-responsive.ad-leaderboard .ad-text { grid-template-columns: 1fr auto; padding: .6rem .8rem; column-gap: .7rem; }
    .vp-responsive.ad-leaderboard .ad-advertiser { grid-column: 1; grid-row: 1; max-width: none; font-size: .62rem; }
    .vp-responsive.ad-leaderboard .ad-headline { grid-column: 1; grid-row: 2; font-size: .95rem; }
    .vp-responsive.ad-leaderboard .ad-body { display: none; }
    .vp-responsive.ad-leaderboard .ad-cta { grid-column: 2; grid-row: 1 / 3; font-size: .75rem; padding: .35rem .55rem; }
    .vp-responsive.ad-billboard .ad-text { padding: 1.4rem; background-image: none; }
    .vp-responsive.ad-billboard .ad-headline { font-size: 1.45rem; }
  }
  .vp-mobile .ad-img-mobile { display: block; }
  .vp-mobile.ad-leaderboard { --ad-h: 100px; }
  .vp-mobile.ad-leaderboard .ad-text { grid-template-columns: 1fr auto; padding: .6rem .8rem; column-gap: .7rem; }
  .vp-mobile.ad-leaderboard .ad-advertiser { grid-column: 1; grid-row: 1; max-width: none; font-size: .62rem; }
  .vp-mobile.ad-leaderboard .ad-headline { grid-column: 1; grid-row: 2; font-size: .95rem; }
  .vp-mobile.ad-leaderboard .ad-body { display: none; }
  .vp-mobile.ad-leaderboard .ad-cta { grid-column: 2; grid-row: 1 / 3; font-size: .75rem; padding: .35rem .55rem; }
  .vp-mobile.ad-billboard .ad-text { padding: 1.4rem; background-image: none; }
  .vp-mobile.ad-billboard .ad-headline { font-size: 1.45rem; }

  .ad-native-body h2 { margin: .35rem 0; }
  .ad-native-body h2 a { text-decoration: none; color: inherit; }
  .ad-native-body h2 a:hover { color: var(--channel, #ad5835); }
  .ad-native-body p { max-width: 790px; margin: .4rem 0 0; }
</style>
