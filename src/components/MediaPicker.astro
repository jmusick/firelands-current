---
import { X } from '@lucide/astro';
import MediaUploadForm from './MediaUploadForm.astro';

// One dialog per page, opened from scripts with openMediaPicker() in src/scripts/media-picker.ts.
// Render it outside any other <form>: the upload tab is a form of its own.
// Element ids derive from `id` so tab/panel associations stay unique if a page ever has two pickers.
const { id = 'media-picker' } = Astro.props;
---
<dialog id={id} class="picker" aria-labelledby={`${id}-title`}>
  <div class="picker-head">
    <h2 id={`${id}-title`}>Choose an image</h2>
    <button type="button" class="close" data-close aria-label="Close"><X /></button>
  </div>
  <div class="tabs" role="tablist" aria-label="Image source">
    <button type="button" role="tab" id={`${id}-tab-library`} data-tab="library" aria-selected="true" aria-controls={`${id}-panel-library`}>Media library</button>
    <button type="button" role="tab" id={`${id}-tab-upload`} data-tab="upload" aria-selected="false" tabindex="-1" aria-controls={`${id}-panel-upload`}>Upload new</button>
  </div>
  <!-- Panels hold focusable controls (search, upload form), so they stay out of the Tab order. -->
  <section role="tabpanel" id={`${id}-panel-library`} aria-labelledby={`${id}-tab-library`} data-panel="library" class="panel">
    <input type="search" class="search" placeholder="Search file name, caption or credit…" aria-label="Search the media library" />
    <p class="visually-hidden" role="status" data-status></p>
    <div class="load-error" hidden>
      <p>Couldn't load images.</p>
      <button type="button" class="button secondary small retry">Retry</button>
    </div>
    <div class="grid"></div>
    <p class="muted empty" hidden>No images yet. Upload one to get started.</p>
    <button type="button" class="button secondary small more" hidden>Load more</button>
  </section>
  <section role="tabpanel" id={`${id}-panel-upload`} aria-labelledby={`${id}-tab-upload`} data-panel="upload" class="panel" hidden>
    <MediaUploadForm submitLabel="Upload and use" />
  </section>
</dialog>

<style>
  .picker { width: min(900px, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); padding: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--fog); color: var(--ink); }
  .picker::backdrop { background: rgb(23 47 54 / .55); }
  .picker-head { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem .5rem; }
  .picker-head h2 { margin: 0; font-size: 1.25rem; }
  .close { border: 0; background: none; color: var(--deep); padding: .3rem; display: inline-flex; }
  .tabs { display: flex; gap: .25rem; padding: 0 1.25rem; border-bottom: 1px solid var(--line); }
  .tabs button { border: 0; background: none; padding: .6rem .9rem; font-weight: 700; color: var(--slate); border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .tabs button[aria-selected='true'] { color: var(--deep); border-bottom-color: var(--channel); }
  .panel { padding: 1rem 1.25rem 1.25rem; }
  .search { width: 100%; padding: .6rem .75rem; border: 1px solid var(--field); border-radius: 3px; background: #fff; margin-bottom: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem; }
  .grid :global(button) { display: grid; gap: .3rem; text-align: left; padding: .4rem; border: 1px solid var(--line-soft); border-radius: 4px; background: var(--paper); color: inherit; font-size: .78rem; min-width: 0; }
  .grid :global(button:hover), .grid :global(button:focus-visible) { border-color: var(--deep); outline: 3px solid var(--deep); }
  .grid :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--shoal-2); border-radius: 2px; }
  .grid :global(.name) { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .grid :global(.dims) { color: var(--slate); }
  .grid :global(.needs-alt) { color: var(--warn); font-weight: 700; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .load-error { margin-bottom: 1rem; color: var(--deep); }
  .load-error p { margin: 0 0 .5rem; font-weight: 700; }
  .more { margin-top: 1rem; }
</style>
