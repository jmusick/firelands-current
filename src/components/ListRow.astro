---
// One row of a story or event list (/news, /search): kicker, headline link, summary, meta line and an optional thumbnail.
// The thumbnail repeats the headline link, so it's hidden from assistive technology and skipped by Tab.
interface Props {
  href: string;
  title: string;
  summary: string;
  image?: { key: string; width: number; height: number } | null;
}

const { href, title, summary, image } = Astro.props;
---
<article class="item"><div class="text"><span class="eyebrow"><slot name="eyebrow" /></span><h2><a href={href}>{title}</a></h2><p class="summary">{summary}</p><p class="meta"><slot name="meta" /></p></div>{image && <a class="thumb" href={href} tabindex="-1" aria-hidden="true"><img src={`/media/${image.key}`} alt="" width={image.width} height={image.height} loading="lazy" /></a>}</article>

<style>
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.75rem; align-items: start; padding: 1.5rem 0; border-bottom: 1px solid var(--line-soft); }
  .text { min-width: 0; }
  .item h2 { margin: .3rem 0 .45rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .item h2 a { color: inherit; text-decoration: none; }
  .item h2 a:hover { color: var(--channel); }
  .summary { max-width: 36em; margin: 0 0 .5rem; font-family: var(--read); font-size: 1.1rem; line-height: 1.5; color: #33474c; }
  .item .meta { margin: 0; }
  .thumb img { display: block; width: 240px; aspect-ratio: 3 / 2; height: auto; object-fit: cover; background: var(--shoal); margin-top: .3rem; }
  @media (max-width: 640px) { .thumb img { width: 110px; } .item { gap: 1rem; } }
</style>
