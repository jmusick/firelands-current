---
interface Props { verb: 'Sign in' | 'Sign up'; }
import { enabledProviders, type SocialProvider } from '../lib/auth';
import { PROVIDER_LABELS } from '../lib/users';
const { verb } = Astro.props;
const providers = enabledProviders();

// Brand marks keep their official colors (Apple's follows the button text).
const ICONS: Record<SocialProvider, string> = {
  google: '<svg viewBox="0 0 18 18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.2045c0-.6381-.0573-1.2518-.1636-1.8409H9v3.4814h4.8436c-.2086 1.125-.8427 2.0782-1.7959 2.7164v2.2581h2.9087c1.7018-1.5668 2.6836-3.874 2.6836-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.4673-.806 5.9564-2.1805l-2.9087-2.2581c-.8059.54-1.8368.859-3.0477.859-2.344 0-4.3282-1.5831-5.036-3.7104H.9574v2.3318C2.4382 15.9832 5.4818 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.2822-1.1168-.2822-1.71s.1023-1.17.2823-1.71V4.9582H.9573A8.9965 8.9965 0 0 0 0 9c0 1.4523.3477 2.8268.9573 4.0418L3.964 10.71z"/><path fill="#EA4335" d="M9 3.5795c1.3214 0 2.5077.4541 3.4405 1.346l2.5813-2.5814C13.4632.8918 11.426 0 9 0 5.4818 0 2.4382 2.0168.9573 4.9582L3.964 7.29C4.6718 5.1627 6.6559 3.5795 9 3.5795z"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>',
  apple: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>',
  microsoft: '<svg viewBox="0 0 21 21" aria-hidden="true"><path fill="#F25022" d="M1 1h9v9H1z"/><path fill="#7FBA00" d="M11 1h9v9h-9z"/><path fill="#00A4EF" d="M1 11h9v9H1z"/><path fill="#FFB900" d="M11 11h9v9h-9z"/></svg>',
};
---
{providers.length > 0 && (
  <div class="social">
    <p class="muted">Or continue with</p>
    <div class="social-row">
      {providers.map((provider) => <button class="button secondary social-button" data-provider={provider} type="button"><span class="social-icon" set:html={ICONS[provider]} />{verb} with {PROVIDER_LABELS[provider]}</button>)}
    </div>
    <p class="message social-message" role="alert" hidden></p>
  </div>
)}
<style>
  .social { margin-top: 2rem; }
  .social-row { display: flex; gap: .6rem; flex-wrap: wrap; }
  .social-button { display: inline-flex; align-items: center; gap: .6rem; cursor: pointer; }
  .social-icon { display: inline-flex; width: 1.15rem; height: 1.15rem; }
  .social-icon :global(svg) { width: 100%; height: 100%; }
</style>
<script>
  import { authClient } from '../lib/auth-client';
  import { NETWORK_ERROR } from '../lib/auth-errors';
  const message = document.querySelector<HTMLElement>('.social-message');
  document.querySelectorAll<HTMLButtonElement>('.social-button').forEach((button) => button.addEventListener('click', async () => {
    const provider = button.dataset.provider as 'google' | 'facebook' | 'apple' | 'microsoft';
    try {
      const result = await authClient.signIn.social({ provider, callbackURL: '/account', newUserCallbackURL: `/account?signup=${provider}` });
      if (result.error && message) { message.textContent = result.error.message || 'Sign in with this provider failed.'; message.hidden = false; }
    } catch {
      if (message) { message.textContent = NETWORK_ERROR; message.hidden = false; }
    }
  }));
</script>
