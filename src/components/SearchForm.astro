---
import { MAX_QUERY_LENGTH } from '../lib/search';

interface Props {
  /** Unique on the page: the header form and a page's own form can appear together. */
  id: string;
  value?: string;
  /** The header's compact form hides its label visually; the input keeps it as its accessible name. */
  compact?: boolean;
}

const { id, value = '', compact = false } = Astro.props;
---
<form class:list={['search-form', { compact }]} role="search" action="/search" method="get">
  <label for={id} class:list={{ 'visually-hidden': compact }}>Search stories and events</label>
  <span class="search-row">
    <input id={id} type="search" name="q" value={value} maxlength={MAX_QUERY_LENGTH} autocomplete="off" enterkeyhint="search" />
    <button type="submit">Search</button>
  </span>
</form>

<style>
  .search-form { display: grid; gap: .4rem; max-width: 34rem; }
  .search-form label { font-weight: 600; font-size: .95rem; }
  .search-row { display: flex; }
  .search-form input { flex: 1 1 auto; min-width: 0; padding: .65rem .8rem; border: 1px solid var(--field); border-right: 0; border-radius: 2px 0 0 2px; background: var(--paper); color: var(--ink); }
  .search-form input:focus { outline: 3px solid var(--channel); outline-offset: 0; border-color: var(--deep); }
  .search-form button { flex: none; padding: .65rem 1rem; background: var(--deep); color: #fff; border: 1px solid var(--deep); border-radius: 0 2px 2px 0; font-weight: 650; font-stretch: 92%; }
  .search-form button:hover { background: var(--deep-2); border-color: var(--deep-2); }
  .search-form.compact { width: 15rem; margin: .4rem 0; }
  .search-form.compact input { padding: .4rem .6rem; border-color: #4f8290; }
  .search-form.compact button { padding: .4rem .75rem; background: transparent; border-color: #4f8290; color: #f4f7f7; font-size: .95rem; }
  .search-form.compact button:hover { background: var(--deep-2); border-color: #d4e4e7; }
  @media (max-width: 700px) { .search-form.compact { width: auto; margin: .6rem 0 .3rem; } }
</style>
