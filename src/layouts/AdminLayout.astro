---
import { BuildingComplex, CalendarDays, ExternalLink, Images, LayoutDashboard, Megaphone, MessagesSquare, Newspaper, Send, SpellCheck, Users } from '@lucide/astro';
import { ADMIN, sectionsFor, type AdminSectionKey } from '../lib/admin';
import { ROLE_LABELS } from '../lib/staff';
import SkipLink from '../components/SkipLink.astro';
import '../styles/tokens.css';

// One icon per admin section; a section added to ADMIN won't type-check until it has one here.
const SECTION_ICONS = {
  dashboard: LayoutDashboard,
  news: Newspaper,
  facebook: Send,
  submissions: Newspaper,
  corrections: SpellCheck,
  events: CalendarDays,
  links: ExternalLink,
  media: Images,
  talk: MessagesSquare,
  users: Users,
  businesses: BuildingComplex,
  ads: Megaphone,
} satisfies Record<AdminSectionKey, unknown>;

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user!;
const role = Astro.locals.staffRole!;
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/admin' ? path === '/admin' : path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <title>{title} | Admin | Firelands Current</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" rel="stylesheet" />
    <style is:global>
      /* The newsroom's tools use the public site's palette and type, set tighter: this is a place for scanning and acting. */
      :root { font-family: var(--scan); color: var(--ink); background: var(--fog); }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--fog); }
      a { color: var(--channel); text-underline-offset: .15em; }
      :focus-visible { outline: 3px solid var(--deep); outline-offset: 2px; box-shadow: 0 0 0 2px #fff; }
      button, input, textarea, select { font: inherit; }
      button { cursor: pointer; }
      input:not([type='hidden']):not([type='checkbox']):not([type='radio']):not([type='file']), select, textarea { min-height: 2.25rem; padding: .5rem .75rem; border: 1px solid var(--field); border-radius: 2px; background: var(--paper); color: var(--ink); line-height: 1.2; }
      input:not([type='hidden']):not([type='checkbox']):not([type='radio']):not([type='file']):focus, select:focus, textarea:focus { outline: 3px solid var(--channel); outline-offset: 0; border-color: var(--deep); }
      input[type='checkbox'], input[type='radio'] { accent-color: var(--deep); }
      h1, h2, h3 { font-family: var(--scan); color: var(--deep); font-weight: 700; font-stretch: 75%; line-height: 1.1; letter-spacing: -.005em; }
      h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin: .2rem 0 1rem; }
      h2 { font-size: 1.45rem; }
      .eyebrow { display: inline-block; color: var(--channel); font-weight: 650; font-size: .95rem; font-stretch: 92%; }
      .lucide { flex-shrink: 0; }
      .button { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 2.25rem; background: var(--deep); color: #fff; border: 1px solid var(--deep); border-radius: 2px; padding: .5rem .85rem; line-height: 1.2; text-decoration: none; font-weight: 650; font-stretch: 92%; }
      .button:hover { background: var(--deep-2); border-color: var(--deep-2); }
      .button.secondary { background: var(--paper); color: var(--deep); border-color: var(--line); }
      .button.secondary:hover { background: var(--shoal); border-color: var(--shoal); }
      .button.small { min-height: 2.25rem; padding: .5rem .7rem; font-size: .9rem; gap: .35rem; }
      .button .lucide { width: 1.1em; height: 1.1em; }
      .back { display: inline-flex; align-items: center; gap: .3rem; }
      .back .lucide { width: 1em; height: 1em; }
      h2 .lucide { width: .85em; height: .85em; margin-right: .45rem; color: var(--channel); vertical-align: -.05em; }
      .card { background: var(--paper); border: 1px solid var(--line-soft); border-radius: 2px; padding: 1.3rem; }
      .muted { color: var(--slate); }
      .meta { color: var(--slate); font-size: .88rem; }
      .form { display: grid; gap: 1rem; }
      .form label { display: grid; grid-template-columns: minmax(0, 1fr); gap: .4rem; font-weight: 600; font-size: .95rem; }
      .form input[type='file'] { width: 100%; min-width: 0; }
      .form input:not([type='hidden']):not([type='checkbox']):not([type='radio']):not([type='file']), .form textarea, .form select { width: 100%; }
      .form textarea { min-height: 180px; resize: vertical; line-height: 1.5; }
      .filters input, .filters select { min-height: 2.25rem; }
      .filters input { flex: 1; min-width: 220px; }
      .filters .button { min-height: 2.25rem; padding: .5rem .75rem; font-size: inherit; }
      .message { padding: .75rem 1rem; border-left: 4px solid var(--alert); color: var(--alert); background: var(--alert-bg); }
      /* Table headers name their columns in sentence case; the rule under them separates them from the rows. */
      th { font-stretch: 90%; }
      .admin-top { background: var(--deep); color: #e6eff0; }
      .admin-top-inner { display: flex; align-items: center; gap: 1rem; padding: .7rem 1.25rem; }
      .admin-brand { display: inline-flex; align-items: center; gap: .6rem; color: #fff; text-decoration: none; font: 800 1.45rem/1 var(--scan); font-stretch: 68%; }
      .admin-brand img { width: 1.8rem; height: auto; }
      .admin-brand small { margin-left: .3rem; font-size: .95rem; font-weight: 600; font-stretch: 90%; color: var(--sunset); }
      .admin-top a.plain { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem 0; color: #e6eff0; font-size: .9rem; white-space: nowrap; }
      .admin-top a.plain .lucide { width: .95rem; height: .95rem; }
      .admin-top .who { margin-left: auto; display: flex; gap: 1.2rem; align-items: center; font-size: .9rem; }
      .admin-top .role { color: #a9c3c8; }
      .admin-shell { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: calc(100vh - 52px); }
      .admin-side { background: var(--shoal-2); border-right: 1px solid var(--line-soft); padding: 1.25rem .75rem; }
      .admin-side a { display: flex; align-items: center; gap: .65rem; padding: .55rem .75rem; border-radius: 2px; color: var(--deep); text-decoration: none; font-weight: 600; font-size: .98rem; font-stretch: 92%; }
      .admin-side a .lucide { width: 1.1rem; height: 1.1rem; color: var(--slate); }
      .admin-side a:hover { background: var(--shoal); }
      .admin-side a[aria-current='page'] { background: var(--deep); color: #fff; }
      .admin-side a[aria-current='page'] .lucide { color: var(--sunset); }
      .admin-main { padding: 1.75rem clamp(1rem, 3vw, 2.5rem) 4rem; min-width: 0; }
      @media (max-width: 800px) {
        .admin-shell { grid-template-columns: minmax(0, 1fr); }
        .admin-side { display: flex; gap: .25rem; overflow-x: auto; padding: .5rem; border-right: 0; border-bottom: 1px solid var(--line-soft); }
        .admin-side a { white-space: nowrap; }
        .admin-top .role { display: none; }
      }
    </style>
  </head>
  <body>
    <SkipLink />
    <header class="admin-top"><div class="admin-top-inner">
      <a class="admin-brand" href="/admin"><img src="/logo-mark.svg" alt="" width="29" height="29" /><span>Firelands Current <small>Admin</small></span></a>
      <div class="who"><a class="plain" href="/"><ExternalLink />View site</a><span class="role">{user.name}, {ROLE_LABELS[role]}</span></div>
    </div></header>
    <div class="admin-shell">
      <nav class="admin-side" aria-label="Admin sections">
        {sectionsFor(role).map((key) => {
          const Icon = SECTION_ICONS[key];
          const { href, label } = ADMIN[key];
          return <a href={href} aria-current={isActive(href) ? 'page' : undefined}><Icon />{label}</a>;
        })}
      </nav>
      <main id="main-content" class="admin-main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
