---
import { env } from 'cloudflare:workers';
import { Menu, X } from '@lucide/astro';
import AdSlot from '../components/AdSlot.astro';
import SkipLink from '../components/SkipLink.astro';
import { pageTakesAds } from '../lib/ads';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Shown when the page is shared on social media, e.g. a story's lead image. */
  image?: { url: string; width: number; height: number; alt: string } | null;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Normalized content filters and pagination, without tracking or form query parameters. */
  canonicalPath?: string;
}

const { title, description = 'Independent local news and conversation for Sandusky and the Firelands.', image, type = 'website', noindex = false, canonicalPath } = Astro.props;
const previewImage = image ?? { url: '/social-logo.png?v=2', width: 1200, height: 630, alt: 'Firelands Current' };
const pageUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.url.origin).href;
const accountPage = ['/sign-in', '/register', '/forgot-password', '/reset-password', '/reauth', '/account', '/business'].some((path) => Astro.url.pathname === path || Astro.url.pathname.startsWith(`${path}/`));
const user = Astro.locals.user;
const staffRole = Astro.locals.staffRole;
const showAds = pageTakesAds(Astro.url.pathname);
// The masthead carries the day's date, as a printed paper does, in the region's own time zone.
const dateline = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const current = (prefix: string) => Astro.url.pathname === prefix || Astro.url.pathname.startsWith(`${prefix}/`) ? 'page' : undefined;
// Account and password pages can contain private information and authentication tokens.
const analyticsHost = Astro.url.protocol === 'https:' && Astro.url.origin === new URL(env.SITE_URL).origin;
const gaId = import.meta.env.PROD && analyticsHost && !accountPage && /^G-[A-Z0-9]+$/.test(env.GA_MEASUREMENT_ID ?? '') ? env.GA_MEASUREMENT_ID : null;
// Staff visits are marked by sign-in rather than IP, which changes; GA's "Internal Traffic" data filter drops them.
const gaConfig = staffRole ? { traffic_type: 'internal' } : {};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(noindex || accountPage) && <meta name="robots" content="noindex" />}
    {!noindex && !accountPage && <link rel="canonical" href={pageUrl} />}
    <!-- Without JavaScript the phone menu can't open, so the nav stays expanded unless this runs. -->
    <script is:inline nonce={Astro.locals.cspNonce}>document.documentElement.classList.add('js');</script>
    {gaId && <>
      <script is:inline nonce={Astro.locals.cspNonce} async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline nonce={Astro.locals.cspNonce} define:vars={{ gaId, gaConfig }}>
        // define:vars wraps this script in a function, so gtag is set on window explicitly for later event calls.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', gaId, gaConfig);
      </script>
    </>}
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Firelands Current" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL(previewImage.url, Astro.url.origin).href} />
    <meta property="og:image:width" content={String(previewImage.width)} />
    <meta property="og:image:height" content={String(previewImage.height)} />
    {previewImage.alt && <meta property="og:image:alt" content={previewImage.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="alternate" type="application/rss+xml" title="Firelands Current" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Firelands Current (JSON Feed)" href="/feed.json" />
    <title>{title} | Firelands Current</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" rel="stylesheet" />
    <style is:global>
      :root { font-family: var(--scan); color: var(--ink); background: var(--fog); }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; background: var(--fog); }
      a { color: var(--channel); text-underline-offset: .15em; text-decoration-thickness: 1px; }
      a:hover { text-decoration-thickness: 2px; }
      :focus-visible { outline: 3px solid var(--deep); outline-offset: 2px; box-shadow: 0 0 0 2px #fff; }
      button, input, textarea, select { font: inherit; }
      button { cursor: pointer; }

      .site-header { background: var(--deep); color: #e6eff0; }
      .masthead { max-width: var(--wrap); margin: auto; padding: 1.6rem 1.25rem 1.2rem; display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; }
      .brand { display: inline-flex; align-items: center; gap: .9rem; color: #f4f7f7; text-decoration: none; font: 800 clamp(2rem, 6.4vw, 4.4rem)/.9 var(--scan); font-stretch: 68%; letter-spacing: -.015em; }
      .brand:hover { color: #fff; }
      .brand-mark { display: block; width: clamp(2.6rem, 5.6vw, 4.2rem); height: auto; flex: none; }
      .dateline { margin: 0; text-align: right; font-size: .9rem; line-height: 1.4; color: #a9c3c8; }
      .dateline strong { display: block; color: #f4f7f7; font-weight: 600; font-size: 1rem; }
      .menu-toggle { display: none; align-items: center; gap: .45rem; padding: .55rem .8rem; background: transparent; color: #f4f7f7; border: 1px solid #4f8290; border-radius: 2px; font-weight: 600; font-stretch: 88%; line-height: 1; }
      .menu-toggle:hover { border-color: #d4e4e7; }
      .menu-toggle .icon-close, .menu-toggle[aria-expanded="true"] .icon-open { display: none; }
      .menu-toggle[aria-expanded="true"] .icon-close { display: block; }
      .nav { border-top: 1px solid var(--deep-2); }
      .nav-inner { max-width: var(--wrap); margin: auto; padding: 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0 1.6rem; align-items: center; }
      .nav a { display: block; padding: .8rem 0 .65rem; border-bottom: 3px solid transparent; text-decoration: none; color: #d4e4e7; font-weight: 600; font-size: 1rem; font-stretch: 88%; }
      .nav a:hover { color: #fff; border-bottom-color: #4f8290; }
      .nav a[aria-current] { color: #fff; border-bottom-color: var(--sunset); }
      .nav .right { margin-left: auto; }

      main { width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 2.25rem 1.25rem 5rem; flex: 1 0 auto; }
      h1, h2, h3 { font-family: var(--scan); color: var(--deep); font-stretch: 72%; font-weight: 700; line-height: 1.05; letter-spacing: -.01em; text-wrap: balance; }
      h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: .25rem 0 1rem; }
      h2 { font-size: 1.75rem; }
      h3 { font-size: 1.3rem; line-height: 1.12; }
      /* A kicker says where a story happened or what kind of thing it is; it is not decoration above a page title. */
      .eyebrow { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 .55rem; color: var(--channel); font-weight: 650; font-size: .95rem; font-stretch: 92%; }
      .eyebrow .section { color: var(--slate); font-weight: 500; padding-left: .55rem; border-left: 1px solid var(--line); }
      .lede { font-family: var(--read); font-size: clamp(1.15rem, 2.2vw, 1.3rem); line-height: 1.5; color: #33474c; max-width: 36em; }
      .button { display: inline-block; background: var(--deep); color: #fff; border: 1px solid var(--deep); border-radius: 2px; padding: .75rem 1.15rem; text-decoration: none; font-weight: 650; font-stretch: 92%; line-height: 1.2; }
      .button:hover { background: var(--deep-2); border-color: var(--deep-2); }
      .button.secondary { background: transparent; color: var(--deep); border-color: var(--line); }
      .button.secondary:hover { background: var(--shoal); border-color: var(--shoal); }
      .button.small { padding: .45rem .8rem; font-size: .92rem; }
      /* Filters over a list (sections, categories, kinds of discussion). On phones they scroll sideways instead of stacking. */
      .filter-tabs { display: flex; flex-wrap: wrap; gap: 0 1.4rem; margin: 1.2rem 0 0; border-bottom: 1px solid var(--line); }
      .filter-tabs a { padding: .55rem 0 .5rem; margin-bottom: -1px; border-bottom: 3px solid transparent; color: var(--slate); font-weight: 600; font-stretch: 90%; text-decoration: none; white-space: nowrap; }
      .filter-tabs a:hover { color: var(--deep); border-bottom-color: var(--line); }
      .filter-tabs a[aria-current] { color: var(--deep); border-bottom-color: var(--deep); }
      @media (max-width: 700px) { .filter-tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -1.25rem; padding-inline: 1.25rem; } }
      .card { background: var(--paper); border: 1px solid var(--line-soft); border-radius: 2px; padding: 1.4rem; }
      .muted { color: var(--slate); }
      .meta { color: var(--slate); font-size: .9rem; font-stretch: 95%; }
      .form { max-width: 580px; display: grid; gap: 1.1rem; }
      .form label { display: grid; gap: .4rem; font-weight: 600; font-size: .95rem; }
      .form input, .form textarea, .form select { width: 100%; padding: .75rem .85rem; border: 1px solid var(--field); border-radius: 2px; background: var(--paper); color: var(--ink); }
      .form textarea { min-height: 180px; resize: vertical; line-height: 1.5; font-family: var(--read); font-size: 1.05rem; }
      .form input:focus, .form textarea:focus, .form select:focus { outline: 3px solid var(--channel); outline-offset: 0; border-color: var(--deep); }
      .message { padding: .8rem 1rem; border-left: 4px solid var(--alert); color: var(--alert); background: var(--alert-bg); }
      .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      /* Validation: a summary that takes focus, then a message and aria-invalid on each field. */
      .field { display: grid; gap: .4rem; }
      .field-error { margin: 0; color: var(--alert); font-weight: 600; font-size: .92rem; }
      .form [aria-invalid="true"] { border-color: var(--alert); box-shadow: inset 0 0 0 1px var(--alert); }
      .error-summary[hidden] { display: none; }
      .error-summary:focus { outline: 3px solid var(--alert); outline-offset: 2px; }
      .error-summary-title { margin: 0 0 .4rem; font-size: 1.15rem; color: var(--alert); font-stretch: 100%; }
      .error-summary ul { margin: 0; padding-left: 1.2rem; }
      .error-summary a { color: inherit; font-weight: 600; }
      .ad-band { padding: .9rem 1.25rem; background: var(--shoal-2); border-bottom: 1px solid var(--line-soft); }
      .site-footer { background: var(--shoal); color: #3d5357; padding: 2.5rem 0 3rem; }
      .site-footer-inner { max-width: var(--wrap); margin: auto; padding: 0 1.25rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem 3rem; font-size: .92rem; }
      .site-footer p { margin: 0; }
      .site-footer .foot-brand { margin: 0 0 .35rem; font: 800 1.6rem/1 var(--scan); font-stretch: 68%; color: var(--deep); }
      .site-footer nav { display: grid; grid-template-columns: repeat(3, auto); gap: 0 2.2rem; align-content: start; }
      /* Padding gives each footer link a 24px-tall target (WCAG 2.5.8) without changing the rhythm of the list. */
      .site-footer nav a { padding: .3rem 0; color: var(--deep); text-decoration: none; font-weight: 600; }
      .site-footer nav a:hover { text-decoration: underline; }
      .site-footer .fine { grid-column: 1 / -1; padding-top: 1.2rem; border-top: 1px solid var(--line); color: var(--slate); font-size: .85rem; }
      @media (max-width: 700px) {
        .masthead { padding: 1rem 1.25rem; align-items: center; }
        .js .dateline { display: none; }
        .js .menu-toggle { display: inline-flex; }
        .js .nav:not(.open) { display: none; }
        .nav-inner { gap: 0 1.1rem; }
        .js .nav-inner { flex-direction: column; align-items: stretch; padding-bottom: .5rem; }
        .nav a { font-size: .95rem; padding: .65rem 0 .5rem; }
        .js .nav a { padding: .85rem 0 .8rem .9rem; font-size: 1.05rem; border-bottom: 0; border-left: 3px solid transparent; }
        .js .nav a + a { border-top: 1px solid var(--deep-2); }
        .js .nav a[aria-current] { border-left-color: var(--sunset); }
        .nav .right { margin-left: 0; }
        .site-footer-inner { grid-template-columns: minmax(0, 1fr); }
        .site-footer nav { grid-template-columns: repeat(2, auto); justify-content: start; }
      }
      @media (max-width: 460px) { .masthead { gap: 1rem; } .brand { gap: .6rem; font-size: clamp(1.5rem, 7vw, 2rem); white-space: nowrap; } .brand-mark { width: clamp(2.1rem, 11vw, 2.6rem); } .dateline { display: none; } }
      @media (max-width: 360px) { .menu-toggle .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
    </style>
  </head>
  <body>
    <SkipLink />
    <header class="site-header">
      <div class="masthead">
        <a class="brand" href="/" aria-label="Firelands Current home"><img class="brand-mark" src="/logo-mark.svg" alt="" width="64" height="64" /><span>Firelands Current</span></a>
        <p class="dateline"><strong>{dateline}</strong><span>News from Sandusky and the Firelands</span></p>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><Menu class="icon-open" size={20} aria-hidden="true" /><X class="icon-close" size={20} aria-hidden="true" /><span class="label">Menu</span></button>
      </div>
      <nav class="nav" id="site-nav" aria-label="Main navigation"><div class="nav-inner">
        <a href="/news" aria-current={current('/news')}>News</a><a href="/events" aria-current={current('/events')}>Events</a><a href="/talk" aria-current={current('/talk')}>Talk of the Town</a><a href="/submit-news" aria-current={current('/submit-news')}>Submit news</a>
        {staffRole && <a class="right" href="/admin/news">Newsroom</a>}
        {user ? <a class={staffRole ? undefined : "right"} href="/account" aria-current={current('/account')}>{user.name}</a> : <a class="right" href="/sign-in" aria-current={current('/sign-in')}>Sign in</a>}
      </div></nav>
    </header>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      const setOpen = (open: boolean) => { toggle?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
      });
    </script>
    <script>
      import '../scripts/outcome-events';
    </script>
    {showAds && <div class="ad-band"><AdSlot placement="site-leaderboard" /></div>}
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="site-footer-inner">
      <div><p class="foot-brand">Firelands Current</p><p>Independent local reporting and conversation for Sandusky and the Firelands.</p></div>
      <nav aria-label="Site">
        <a href="/submit-news">Submit news</a><a href="/contact">Contact</a><a href="/advertise">Advertise</a>
        <a href="https://www.facebook.com/people/Firelands-Current/61594659460586/" rel="me noopener" target="_blank">Facebook</a><a href="https://x.com/FirelandCurrent" rel="me noopener" target="_blank">X</a><a href="/rss.xml">RSS feed</a>
        <a href="/privacy">Privacy</a><a href="/terms">Terms</a>
      </nav>
      <p class="fine">© {new Date().getFullYear()} Firelands Current, owned and operated by <a href="https://stonedragonmedia.com/">Stone Dragon Media, LLC</a>. Version {__APP_VERSION__}.</p>
    </div></footer>
  </body>
</html>
