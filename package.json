    "test:authorization": "node --test scripts/test-authorization.mjs",
    "test:secret-scan": "node --test scripts/test-secret-scan.mjs",
    "test:tip-retention": "node --test scripts/test-tip-retention.mjs",
    "test:auth-alerts": "node --test scripts/test-auth-alerts.mjs",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
