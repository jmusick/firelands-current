    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^26.6.3",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0"
